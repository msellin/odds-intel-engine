# RAILWAY-ELIMINATION (2026-06-29): systemd unit for the OddsIntel pipeline
# scheduler on Hetzner VPS.
#
# NOTE (2026-09-03): the header used to say "2 vCPU / 4 GB RAM". The box is
# actually 8 vCPU / 15.6 GB, so SCHEDULER_PROCESS_MB_LIMIT below is calibrated
# against a machine that no longer matches -- see the INFRASTRUCTURE.md spec
# drift note. Left as-is rather than raised blind: a memory alarm that fires
# early is safe, one raised without measuring is not.
#
# Install:
#   cp local/systemd/oddsintel-scheduler.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable oddsintel-scheduler
#   systemctl start oddsintel-scheduler
#
# Manage:
#   systemctl status oddsintel-scheduler          # health + last exit code
#   journalctl -u oddsintel-scheduler -f          # live logs
#   systemctl restart oddsintel-scheduler         # force restart (e.g. after code pull)
#   systemctl stop oddsintel-scheduler            # graceful stop
#
# After a code pull (git pull && venv/bin/pip install -r requirements.txt):
#   systemctl restart oddsintel-scheduler
#
# IMPORTANT: WorkingDirectory and EnvironmentFile paths are hard-coded for
# /opt/odds-intel-engine. If the repo is cloned elsewhere, edit both.

[Unit]
Description=OddsIntel Pipeline Scheduler
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/odds-intel-engine

# .env carries all secrets (DATABASE_URL, API keys, Telegram, etc.).
# EnvironmentFile is evaluated BEFORE Environment= lines so the explicit
# overrides below win even if .env has a conflicting value.
EnvironmentFile=/opt/odds-intel-engine/.env

# Pinned overrides — these override whatever .env says.
Environment=TZ=UTC
Environment=PYTHONUNBUFFERED=1
# Always use the Hetzner-local FlareSolver, never the Railway-hosted one.
Environment=FLARESOLVERR_URL=http://localhost:8191
# COOLBET-MOVED-TO-VPS 2026-09-23 — Coolbet reads through the Estonian exit node.
# Imperva blocks this box's own IP; through zone.ee the sweep completes normally.
# socks5h so DNS resolves at the exit. Its own switch, separate from Epicbet's,
# because the two moved on different days for different reasons.
Environment=COOLBET_RESIDENTIAL_PROXY=socks5h://127.0.0.1:1081
# Alert threshold calibrated for 4 GB RAM: warn at 3.4 GB (85%).
Environment=SCHEDULER_PROCESS_MB_LIMIT=4096

# SCHEDULER-PORT-8080-HARDEN-2026-07-13. An orphaned scheduler from the Jul 09
# cutover held :8080 for four days, then hung on Jul 12 without restarting --
# 33 hours with no pipeline_runs. A duplicate unit under the pre-rename name
# (odds-scheduler.service) was crash-looping on the same port every 15s.
#
# Nudge any stray listener off the health port before starting. `|| true` so a
# clean box, where nothing holds the port, is not treated as a failure -- that
# would turn a hardening step into a new way of failing to start.
ExecStartPre=-/bin/sh -c '/usr/bin/fuser -k 8080/tcp || true'

ExecStart=/opt/odds-intel-engine/venv/bin/python3 -m workers.scheduler

# Restart policy: always restart, wait 30s between attempts (matches
# ThrottleInterval on Mac launchd). If scheduler exits cleanly (deploy
# restart), systemd brings it back automatically.
Restart=always
RestartSec=30

# SCHEDULER-IGNORES-SIGTERM-ON-DEPLOY (2026-09-21). Was 60s, and that was not
# enough: `State 'stop-sigterm' timed out. Killing.` appeared 19 times in the 14
# days to 2026-09-21, i.e. roughly every other deploy restart ended in SIGKILL.
#
# These were never crashes. The scheduler DOES handle SIGTERM — it sets a flag,
# leaves its keep-alive loop within a second, and then calls
# `scheduler.shutdown(wait=True)`, which blocks until every RUNNING job returns.
# A settlement pass, a morning chain or an odds sweep routinely exceeds 60s, so
# systemd killed the process in the middle of one. `Restart=always` brought it
# straight back, which is why the service always looked healthy afterwards.
#
# 300s is the drain the scheduler now asks for (SHUTDOWN_DRAIN_S), plus headroom
# to log which jobs it gave up on. The scheduler bounds itself, so this is a
# ceiling systemd should never actually reach — if it does, that is the signal
# that a job is genuinely stuck rather than merely slow.
TimeoutStopSec=300

# Log goes to journald (use journalctl -u oddsintel-scheduler).
# For a plain file mirror: StandardOutput=append:/opt/odds-intel-engine/dev/active/scheduler.log
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oddsintel-scheduler

[Install]
WantedBy=multi-user.target

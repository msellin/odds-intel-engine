<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  COOLBET-MAC-DAEMON (2026-06-12): launchd job for the placement daemon.

  Install once:
    cp local/launchd/com.oddsintel.coolbet-mac-daemon.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.oddsintel.coolbet-mac-daemon.plist

  Manage:
    launchctl list | grep oddsintel              # check it's loaded
    launchctl kickstart -k gui/$(id -u)/com.oddsintel.coolbet-mac-daemon  # force restart
    launchctl unload ~/Library/LaunchAgents/com.oddsintel.coolbet-mac-daemon.plist  # stop

  Tail logs:
    tail -f /Users/margussellin/www/odds-intel-engine/dev/active/coolbet-mac-daemon.log

  IMPORTANT: paths are absolute and hard-coded for THIS Mac. If the repo
  ever moves, edit WorkingDirectory + ProgramArguments + StandardOutPath.
  This is a per-user LaunchAgent (not a global LaunchDaemon) so it only
  runs when the operator is logged in — exactly what we want.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.oddsintel.coolbet-mac-daemon</string>

    <!-- Run the daemon as `python -m workers.automation.coolbet_mac_daemon`
         so module-resolution + .env loading mirror local manual runs. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>-m</string>
        <string>workers.automation.coolbet_mac_daemon</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/margussellin/www/odds-intel-engine</string>

    <!-- Auto-start at login + auto-restart on crash. ThrottleInterval
         prevents an unrecoverable bug from busy-looping (e.g. a config
         error causing instant exit) — wait 30s between restart attempts. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- Inherit FLARESOLVERR_URL via .env (loaded by dotenv inside the
         module). If you want to override, prepend EnvironmentVariables
         here. The default expects the local FS at localhost:8191. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <!-- Override the .env value so we never accidentally hit the
             Railway-hosted FS from the daemon (defeats the residential-IP
             premise). Edit if you intentionally want to route via Railway. -->
        <key>FLARESOLVERR_URL</key>
        <string>http://localhost:8191</string>
        <!-- 30-min poll matches the betting pipeline cohort cadence.
             Shorter = wasted work + Chrome-window flash.
             Override at runtime: launchctl setenv COOLBET_MAC_POLL_S 600 -->
        <key>COOLBET_MAC_POLL_S</key>
        <string>1800</string>
        <!-- BOT-MATURITY-GATE (2026-06-12): only auto-place from bots
             tagged maturity_label='calibrated'. Without this gate every
             active bot (beta, experimental, etc.) could spend real
             money. Audit 2026-06-12 showed bot_high_alignment (beta)
             losing -€56 over 50 real bets while bot_v10_all (calibrated)
             earned +€37 — the maturity gate captures this signal.
             Railway has the same env set; this is the Mac-side mirror
             (Railway env doesn't reach this process, only its local env
             does — that was the gap that let beta bots auto-place).
             Override: launchctl setenv COOLBET_RECORD_ALLOWED_MATURITY
             "calibrated,beta" — or '*' to disable the gate entirely. -->
        <!-- COOLBET-MATURITY-GATE-WIDENED (2026-07-06): daemon is now
             paper-only (execute=False), so the maturity filter's original
             role as a real-money safety gate no longer applies. Widened
             to `*` = ALL active bots. Rationale: paper bets cost nothing
             and every candidate gives us "what would Coolbet have quoted"
             signal for the admin place-bets suggestion queue and for the
             per-bot ROI leaderboard. Narrowing again is a decision to
             make ONLY when this daemon flips to execute=True on a
             specific proven-out bot slice. -->
        <key>COOLBET_RECORD_ALLOWED_MATURITY</key>
        <string>*</string>
        <!-- COOLBET-AUTO-LOGIN-ON-HEAL (2026-06-18): when auto_self_heal
             detects the CDP-Chrome session has logged out (Coolbet
             expires the session every few hours overnight), let
             auto-heal run cdp_auto_login() to re-establish it. SAFETY:
             this is the BROWSER form-submit path (not the API endpoint
             that caused the 2026-06-11 SMS storm) and is rate-limited
             to once per hour. If Coolbet does require SMS, the form
             submit waits 5min for browser-side entry and then times
             out — at worst ONE SMS per hour, not the 100/night
             that drove the original incident. Verified 2026-06-17/18:
             two consecutive auto-login runs completed with ZERO SMS
             — Coolbet recognises the CDP profile as device-trusted. -->
        <key>COOLBET_AUTO_LOGIN_ON_HEAL</key>
        <string>true</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/margussellin/www/odds-intel-engine/dev/active/coolbet-mac-daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/margussellin/www/odds-intel-engine/dev/active/coolbet-mac-daemon.log</string>
</dict>
</plist>
